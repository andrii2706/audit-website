# Generated by scripts/server/setup.sh from scripts/server/nginx/site.conf.template ({{…}} = values for one environment).
# certbot --nginx later adds the HTTPS server parts and the http → https redirect to this file.

# ——— Website (Next.js)
server {
  listen 80;
  server_name {{SITE_HOSTS}};
  client_max_body_size 2m;

  # Never serve dotfiles (.env, .git …) even if one ends up in a public folder.
  location ~ /\.(?!well-known/) { deny all; }

  # Called by the CMS directly on 127.0.0.1; never reachable from the internet.
  location = /api/revalidate { deny all; }

  # Pages: 5/s per IP with a burst of 120 (people never notice; bulk downloaders get 429) + 10 POST/min (lead form).
  location / {
{{STAGING_AUTH}}
    limit_req zone=bp_site_get burst=120 nodelay;
    limit_req zone=bp_site_post burst=10 nodelay;
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Built JS/CSS/fonts (hashed, immutable): no limits.
  location /_next/static/ {
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    proxy_set_header Host $host;
  }

  # Resized images: other sites may not embed them (hotlinking); search engines may.
  location /_next/image {
{{STAGING_AUTH}}
    valid_referers none blocked server_names ~\.google\. ~\.bing\.;  # server_names = this site
    if ($invalid_referer) { return 403; }
    limit_req zone=bp_site_get burst=120 nodelay;
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}

# ——— CMS (Strapi admin, API, uploaded files)
server {
  listen 80;
  server_name {{CMS_HOST}};
  client_max_body_size 50m;

  location ~ /\.(?!well-known/) { deny all; }

  location = /admin/login {
    limit_req zone=bp_admin_login burst=5 nodelay;
    proxy_pass http://127.0.0.1:{{CMS_PORT}};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Content API: closed to the internet. The website reads it on 127.0.0.1 with its token, and the admin panel uses
  # its own routes (/admin, /content-manager, /upload …), so nothing outside needs /api/. See docs/SECURITY.md.
  location /api/ { return 403; }

  # Uploaded images/PDFs: other sites may not embed them directly (hotlinking); search engines may.
  location /uploads/ {
    valid_referers none blocked server_names {{SITE_HOSTS}} ~\.google\. ~\.bing\.;
    if ($invalid_referer) { return 403; }
    add_header X-Content-Type-Options nosniff always;
    proxy_pass http://127.0.0.1:{{CMS_PORT}};
    proxy_set_header Host $host;
  }

  location / {
    proxy_pass http://127.0.0.1:{{CMS_PORT}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
