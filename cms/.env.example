# Copy to .env and replace every "tobemodified" value (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))").
HOST=0.0.0.0
PORT=1337
# Production: public https URL of the CMS (leave empty locally)
# Production: the public address of the CMS, e.g. https://cms.bp-audit.com.ua
PUBLIC_URL=
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# On-demand revalidation of the website after content changes (REVALIDATE_SECRET must match web/.env.local)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
# Seed an empty database with the starter content in all 6 languages (true/false)
SEED_ON_EMPTY=true

# Database: sqlite (local) | postgres | mysql
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_URL=postgres://user:pass@host:5432/db
